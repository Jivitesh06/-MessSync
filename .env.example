# MessSync — Environment Variables Template
# Copy this file to .env or .env.local to connect to your live Firebase project.
# If these variables are left empty, MessSync automatically operates in high-fidelity
# local/offline mode with IndexedDB persistence, seeded with the full Chitkara menu.

# Firebase Web App Credentials (from Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=messsync-chitkara.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=messsync-chitkara
VITE_FIREBASE_STORAGE_BUCKET=messsync-chitkara.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Custom API URL if using a custom backend for OCR or server aggregation
# VITE_OCR_API_URL=https://vision.googleapis.com/v1/images:annotate

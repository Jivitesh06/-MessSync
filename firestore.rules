rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Administrator verification: requires custom claim 'admin: true' or an explicit 'admin' role in users/{uid}
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Users Collection: users can read their own profile; admins can read/write
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Published Week Menus: public can read; only verified admins can modify
    match /menuWeeks/{weekId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Historical Published Version Snapshots: public can read past published history; only admins write
    match /menuVersions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu Drafts: STRICTLY ADMIN ONLY. Students must never be able to read or write drafts.
    match /menuDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Rating Aggregates: Public can read aggregate averages and counts.
    // Untrusted clients CANNOT write or tamper with aggregates directly.
    // Updates are handled exclusively by server-side Cloud Functions / Admin SDK transactions.
    match /ratingAggregates/{mealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Individual Meal Ratings:
    // Anonymous/authenticated students can submit their own meal rating.
    match /ratings/{ratingId} {
      // Public can read published reviews; only admins can view flagged or hidden reviews
      allow read: if resource.data.status == 'published' || isAdmin();

      // Create rating: enforce 1 rating per device per meal deterministic docId
      allow create: if
        ratingId == request.resource.data.mealId + '_' + request.resource.data.deviceId &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.deviceId is string &&
        request.resource.data.deviceId.size() >= 8 &&
        request.resource.data.mealId is string &&
        request.resource.data.status == 'published' &&
        (!('comment' in request.resource.data) || request.resource.data.comment.size() <= 300);

      // Update rating: student can edit rating/tags/comment for their own device record
      allow update: if
        isAdmin() ||
        (
          ratingId == resource.data.mealId + '_' + resource.data.deviceId &&
          request.resource.data.mealId == resource.data.mealId &&
          request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.status == resource.data.status &&
          (!('comment' in request.resource.data) || request.resource.data.comment.size() <= 300)
        );

      // Only administrators can delete or moderate ratings
      allow delete: if isAdmin();
    }

    // Audit Logs: Append-only by admins, completely immutable (no updates or deletes)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // App Configuration & Timing Settings
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
